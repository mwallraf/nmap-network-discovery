# Copy to .env and adjust; every setting is optional.

# Image to run or build, and its tag (latest, main, 1.2.0, ...)
NMAP_DISCOVERY_IMAGE=ghcr.io/mwallraf/nmap-network-discovery
NMAP_DISCOVERY_TAG=latest

# Group ID of the "app" group in the image (build only)
GROUPID=20001

# Proxy for apt during the build (build only)
# http_proxy=http://proxy.example.com:3128
# https_proxy=http://proxy.example.com:3128
